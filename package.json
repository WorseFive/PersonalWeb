{
  "name": "personalweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts",
    "test:functional": "node scripts/run-functional-tests.mjs",
    "test:functional:production": "node scripts/run-functional-tests.mjs --production",
    "test:supabase": "node scripts/run-supabase-contract-tests.mjs",
    "test:live": "node scripts/run-live-production-tests.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:functional && npm run test:functional:production"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
