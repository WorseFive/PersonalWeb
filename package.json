{
  "name": "personalweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts",
    "check:project": "node scripts/check-project.mjs",
    "check:release": "node scripts/check-release-boundary.mjs",
    "test:static": "node scripts/test-static.mjs",
    "editor:install": "npm install --prefix editor",
    "editor:check": "npm run check --prefix editor",
    "editor:build": "npm run build --prefix editor",
    "editor:test": "cargo test --manifest-path editor/src-tauri/Cargo.toml",
    "verify:static": "npm run check:project && npm run check:release && npm run typecheck && npm run test && npm run build && npm run test:static",
    "verify": "npm run verify:static"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
