{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PersonalWeb Editor",
  "version": "0.1.0",
  "identifier": "com.worsefive.personalweb.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "PersonalWeb 编辑器", "width": 1260, "height": 900, "minWidth": 820, "minHeight": 680, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "icon": ["icons/icon.ico", "icons/icon.svg"] }
}
