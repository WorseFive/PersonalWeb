# Set distinct long random values before local administrator access is enabled.
ADMIN_PASSWORD=replace-with-a-long-local-password
SESSION_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-another-at-least-32-random-characters

# Optional. Defaults to .data in the project root.
# PORTAL_DATA_DIR=C:/path/to/private/local-data

# Production only. Set all three in the hosting provider; the app otherwise
# keeps using the local development adapter.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# SUPABASE_STORAGE_BUCKET=portal-resources
# SITE_URL=https://your-production-domain.example
