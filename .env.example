# Static GitHub Pages build configuration.
# SITE_URL=https://worsefive.github.io/PersonalWeb/
# NEXT_PUBLIC_BASE_PATH=/PersonalWeb

# Deferred dynamic-server configuration (not used by the GitHub Pages release).
# Keep these values outside Git if the server architecture is restored.
# ADMIN_PASSWORD=replace-with-a-long-local-password
# SESSION_SECRET=replace-with-at-least-32-random-characters
# RATE_LIMIT_SECRET=replace-with-another-at-least-32-random-characters
# PORTAL_DATA_DIR=C:/path/to/private-local-data
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key-for-contract-tests
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# SUPABASE_STORAGE_BUCKET=portal-resources
# PORTAL_TEST_BASE_URL=https://your-production-domain.example
# PORTAL_TEST_ADMIN_PASSWORD=the-same-admin-password-used-by-the-deployment
